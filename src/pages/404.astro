---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Dan Hughes"
  description="This page does not exist. Try the homepage, Notes or Experiments."
  indexable={false}
>
  <section class="page-intro not-found" aria-labelledby="not-found-title">
    <p class="eyebrow">404 / Not found</p>
    <h1 id="not-found-title">
      Nothing <em>here.</em>
    </h1>
    <p class="intro-description">
      The address may have changed or never existed. These still work.
    </p>
    <ul class="not-found-links">
      <li>
        <a class="text-link" href="/">
          Home
        </a>
      </li>
      <li>
        <a class="text-link" href="/notes/">
          Notes
        </a>
      </li>
      <li>
        <a class="text-link" href="/experiments/">
          Experiments
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    margin-block-start: var(--space-lg);
    padding: 0;
    list-style: none;
  }
</style>
