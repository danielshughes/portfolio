---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignalField from "../components/SignalField.astro";
import SignalControls from "../components/SignalControls.astro";
import ExperimentCard from "../components/ExperimentCard.astro";
import InternetMap from "../components/InternetMap.astro";
import "../styles/playground.css";
import { connections, nodes } from "../playground/topology";
import { portfolioContent } from "../content/portfolio";
---

<BaseLayout
  title="Experiments | Dan Hughes"
  description="Browser-local experiments with Kubernetes, AI agents and MCP, waves and a 3D network. Explore observed Internet traffic with Cloudflare Radar."
>
  <section class="play-intro page-intro" aria-labelledby="play-title">
    <p class="eyebrow">A few adjustable distractions</p>
    <h1 id="play-title">
      What happens <em>if you…</em>
    </h1>
    <p class="intro-description">
      Small experiments, made to be played with.
      <br />
      Nothing connected to anything important.
    </p>
  </section>
  <div class="experiment-collection">
    <ExperimentCard
      id="kubernetes"
      number="01"
      title="Room for one more?"
      subtitle="More replicas. Somewhere to put them."
      label="Kubernetes / CPU-only simulation"
    >
      <svg
        slot="stage"
        class="system-chart"
        viewBox="0 0 600 320"
        aria-hidden="true"
      ></svg>
      <p>
        Turn up the demand. Watch the replica target grow, then see which pods
        actually fit.
      </p>
      <div class="experiment-controls" hidden>
        <label>
          CPU demand
          <input
            name="load"
            type="range"
            min="0"
            max="6000"
            step="100"
            value="1200"
          />
        </label>
        <label>
          CPU request per pod
          <input
            name="cpuRequest"
            type="range"
            min="100"
            max="1000"
            step="100"
            value="500"
          />
        </label>
        <label>
          Target utilisation
          <input
            name="target"
            type="range"
            min="40"
            max="80"
            step="5"
            value="60"
          />
        </label>
        <label>
          Nodes
          <input name="nodes" type="range" min="1" max="4" value="2" />
        </label>
        <button type="button" data-playback>
          Pause
        </button>
        <button type="button" data-reset>
          Reset
        </button>
      </div>
      <output aria-live="polite" aria-atomic="true">
        The HPA sets a replica target. Workload controllers create pods; the
        scheduler finds room. A pending pod has no placement yet.
      </output>
      <p class="experiment-footnote">
        One CPU snapshot from two ready replicas. Each node has 2,000m available
        CPU. Illustrative least-used placement, not the full Kubernetes
        scheduler. No memory, affinity, readiness delays or HPA stabilisation.
        Nodes are added manually here.
      </p>
    </ExperimentCard>
    <ExperimentCard
      id="mcp"
      number="02"
      title="Who’s allowed to do what?"
      subtitle="An agent, some tools, and a few boundaries."
      label="AI agents + MCP / scripted simulation"
    >
      <svg
        slot="stage"
        class="system-chart"
        viewBox="0 0 600 320"
        aria-hidden="true"
      ></svg>
      <p>
        A stalled collection, a tool-call budget and a host that can say no.
        Change the scenario and follow the decisions.
      </p>
      <div class="experiment-controls" hidden>
        <fieldset class="scenario-choices">
          <legend>Scenario</legend>
          {[
            ["read", "Read-only"],
            ["approval", "Approval"],
            ["timeout", "Timeout"],
            ["context", "Missing context"],
          ].map(([value, label]) => (
            <label>
              <input
                type="radio"
                name="scenario"
                value={value}
                checked={value === "read"}
              />
              {label}
            </label>
          ))}
        </fieldset>
        <label>
          Tool-call budget
          <input name="budget" type="range" min="0" max="4" value="3" />
        </label>
        <div class="experiment-actions approval-actions" hidden>
          <button type="button" data-approve>
            Allow simulated write
          </button>
          <button type="button" data-deny>
            Deny simulated write
          </button>
        </div>
        <button type="button" data-playback>
          Pause
        </button>
        <button type="button" data-reset>
          Reset
        </button>
      </div>
      <output aria-live="polite" aria-atomic="true">
        The agent proposes a tool call. This imaginary host applies its own
        approval policy before a simulated write.
      </output>
      <details class="trace-list">
        <summary>Read the trace</summary>
        <ol>
          <li>Receive the task and check the available context.</li>
          <li>Propose a read-only tool call within the host's budget.</li>
          <li>Review the result. A proposed write needs host approval.</li>
          <li>
            Report the findings, or stop when context, permission or budget is
            missing.
          </li>
        </ol>
      </details>
      <p class="experiment-footnote">
        A scripted agent loop, not a live model or MCP server. Approval and
        budgets belong to this host policy, not automatic guarantees provided by
        MCP. Failed attempts count towards the budget.
      </p>
    </ExperimentCard>
    <ExperimentCard
      id="wave"
      number="03"
      title="A little interference."
      subtitle="Same wave. A different view."
      label="Waveform / synthetic interference"
    >
      <SignalField slot="stage" expanded externalControls />
      <p>
        The clean reference stays above. Add interference below, then change the
        frequency and amplitude.
      </p>
      <SignalControls expanded />
      <p class="experiment-footnote">
        A visual experiment, not signal recovery or incident detection. Open the
        controls to adjust the waveform.
      </p>
    </ExperimentCard>
    <ExperimentCard
      id="latency"
      number="04"
      title="The average looks fine."
      subtitle="Until you look at the slow end."
      label="100 synthetic requests / milliseconds"
    >
      <Fragment slot="stage">
        <svg class="data-chart" viewBox="0 0 800 300" aria-hidden="true"></svg>
        <p class="chart-axis">
          <span>Fastest</span>
          <span>Slowest →</span>
        </p>
      </Fragment>
      <p>Same hundred requests. Make the slowest ten slower.</p>
      <div class="experiment-controls" hidden>
        <label>
          Slow requests
          <input
            name="tail"
            type="range"
            min="100"
            max="2000"
            step="50"
            value="500"
          />
        </label>
        <button type="button" data-playback>
          Pause
        </button>
        <button type="button" data-reset>
          Reset
        </button>
      </div>
      <output aria-live="polite" aria-atomic="true">
        The median stays steady while the upper percentiles increase.
      </output>
      <p class="experiment-footnote">
        Sorted samples, fixed 0–2,000 ms scale. The readout gives the final
        distribution; the animation draws it in. No live traffic.
      </p>
    </ExperimentCard>
    <ExperimentCard
      id="requests"
      number="05"
      title="Requests in flight."
      subtitle="A little parallelism. A definite limit."
      label="12 synthetic requests / one lookup deadline"
    >
      <Fragment slot="stage">
        <svg class="data-chart" viewBox="0 0 800 300" aria-hidden="true"></svg>
        <p class="chart-axis">
          <span>Start</span>
          <span>Time →</span>
        </p>
      </Fragment>
      <p>Fit the lookup inside its deadline. Queued requests count too.</p>
      <div class="experiment-controls" hidden>
        <label>
          Concurrency
          <input name="concurrency" type="range" min="1" max="6" value="2" />
        </label>
        <label>
          Request latency
          <input
            name="latency"
            type="range"
            min="100"
            max="600"
            step="50"
            value="200"
          />
        </label>
        <label>
          Lookup deadline
          <input
            name="deadline"
            type="range"
            min="200"
            max="2400"
            step="100"
            value="1000"
          />
        </label>
        <button type="button" data-playback>
          Pause
        </button>
        <button type="button" data-reset>
          Reset
        </button>
      </div>
      <output aria-live="polite" aria-atomic="true">
        Two requests at a time shorten this illustrative schedule compared with
        a sequential lookup.
      </output>
      <p class="experiment-footnote">
        Uniform duration, no retries or upstream contention. The readout gives
        the result at the deadline. Outlines are planned work; hatching marks
        work cut short.
      </p>
    </ExperimentCard>
    <ExperimentCard
      id="world"
      number="06"
      title="A small connected world."
      subtitle="Give it a spin. Follow a connection."
      label="An imaginary system / projected in 3D"
    >
      <div slot="stage" class="world-stage">
        <canvas hidden aria-hidden="true"></canvas>
      </div>
      <p>
        Drag to turn, or use the rotation controls. Choose a node to follow its
        direct connections.
      </p>
      <div class="experiment-controls" hidden>
        <label>
          Rotation
          <input name="rotation" type="range" min="0" max="360" value="25" />
        </label>
        <label>
          Tilt
          <input name="tilt" type="range" min="-60" max="60" value="15" />
        </label>
        <div class="node-choices" role="group" aria-label="Highlight a node">
          {nodes.map(({ name }) => (
            <button type="button" data-node aria-pressed="false">
              {name}
            </button>
          ))}
        </div>
        <button type="button" data-pause>
          Pause rotation
        </button>
        <button type="button" data-reset>
          Reset
        </button>
      </div>
      <output aria-live="polite" aria-atomic="true">
        All connections visible.
      </output>
      <details class="connection-list">
        <summary>Read the connections</summary>
        <ul>
          {connections.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </details>
    </ExperimentCard>
  </div>
  <InternetMap />
  <section class="play-outro" aria-labelledby="play-outro-title">
    <h2 id="play-outro-title">
      No real systems
      <br />
      <em>were harmed.</em>
    </h2>
    <div>
      <p>
        The little simulations run in your browser. The Internet atlas looks
        further afield, using public observations from Cloudflare Radar.
      </p>
      <a
        class="text-link"
        href={portfolioContent.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        Explore the source ↗<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </section>
</BaseLayout>
<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const cards = [
    ...document.querySelectorAll<HTMLElement>("[data-experiment]"),
  ];
  const visible = new Set<Element>();
  function syncPreviews() {
    for (const card of cards)
      card.dataset.previewMotion =
        !reduced.matches &&
        !document.hidden &&
        visible.has(card) &&
        !card.querySelector<HTMLDetailsElement>(".experiment-settings")!.open
          ? "running"
          : "paused";
  }
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting)
        visible.add(entry.target.closest(".experiment")!);
      else visible.delete(entry.target.closest(".experiment")!);
    }
    syncPreviews();
  });
  reduced.addEventListener("change", syncPreviews);
  document.addEventListener("visibilitychange", syncPreviews);
  for (const card of cards) {
    observer.observe(card.querySelector(".experiment-stage")!);
    const settings = card.querySelector<HTMLDetailsElement>(
      ".experiment-settings",
    )!;
    let loaded = false;
    const loadExperiment = async () => {
      syncPreviews();
      if (!settings.open || loaded) return;
      loaded = true;
      try {
        if (card.dataset.experiment === "world") {
          const { mountWorld } = await import("../playground/world");
          mountWorld(card);
          if (!card.classList.contains("world-ready")) return;
        } else if (["kubernetes", "mcp"].includes(card.dataset.experiment!)) {
          const { mountSystem } = await import("../playground/systems");
          mountSystem(card);
        } else if (card.dataset.experiment !== "wave") {
          const { mountChart } = await import("../playground/charts");
          mountChart(card);
        }
        card.classList.add("experiment-ready");
        card.querySelector<HTMLElement>(".interactive-stage")!.hidden = false;
      } catch {
        const output = card.querySelector("output");
        if (output)
          output.textContent =
            "The interactive view could not load. The preview is still available. Reload the page to try downloading it again.";
        const reload = document.createElement("button");
        reload.type = "button";
        reload.textContent = "Reload page";
        reload.addEventListener("click", () => window.location.reload());
        output?.after(reload);
      }
    };
    settings.addEventListener("toggle", () => {
      void loadExperiment();
    });
    // Browsers can restore an open disclosure during a page reload.
    if (settings.open) void loadExperiment();
  }
  syncPreviews();
</script>
