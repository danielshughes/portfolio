---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignalField from "../components/SignalField.astro";
import SignalControls from "../components/SignalControls.astro";
import ExperimentCard from "../components/ExperimentCard.astro";
import InternetMap from "../components/InternetMap.astro";
import LiveExperiments from "../components/LiveExperiments.astro";
import "../styles/playground.css";
import { connections, nodes } from "../playground/topology";
import { portfolioContent } from "../content/portfolio";
---

<BaseLayout
  title="Experiments | Dan Hughes"
  description="Kubernetes and MCP simulations, observed Internet traffic, connection details and small live experiments with Cloudflare Workers."
>
  <section class="play-intro page-intro" aria-labelledby="play-title">
    <p class="eyebrow">A few adjustable distractions</p>
    <h1 id="play-title">
      What happens <em>if you…</em>
    </h1>
    <p class="intro-description">
      Small controls, visible consequences.
      <br />
      Browser simulations are self-contained; live cards use bounded demo
      endpoints.
    </p>
  </section>
  <div class="experiment-collection">
    <ExperimentCard
      id="kubernetes"
      tone="peach"
      tinted
      number="01"
      title="Room for one more?"
      subtitle="Raise CPU demand and watch the replica target change, then see which pods fit."
      label="Kubernetes HPA / SVG simulation"
    >
      <svg
        slot="stage"
        class="system-chart"
        viewBox="0 0 600 320"
        aria-hidden="true"
      ></svg>
      <p>
        Turn up CPU demand. HPA changes the target, then the scheduler tries to
        place each pod.
      </p>
      <div class="experiment-controls" hidden>
        <label>
          CPU demand
          <input
            name="load"
            type="range"
            min="0"
            max="6000"
            step="100"
            value="1200"
          />
        </label>
        <label>
          CPU request per pod
          <input
            name="cpuRequest"
            type="range"
            min="100"
            max="1000"
            step="100"
            value="500"
          />
        </label>
        <label>
          Target utilisation
          <input
            name="target"
            type="range"
            min="40"
            max="80"
            step="5"
            value="60"
          />
        </label>
        <label>
          Nodes
          <input name="nodes" type="range" min="1" max="4" value="2" />
        </label>
        <button type="button" data-playback>
          Pause
        </button>
        <button type="button" data-reset>
          Reset
        </button>
      </div>
      <output aria-live="polite" aria-atomic="true">
        HPA sets the replica target. Placement uses each pod's CPU request, so a
        pod can stay pending when there is no room.
      </output>
      <p class="experiment-footnote">
        One CPU snapshot from two ready replicas. Each node has 2,000m available
        CPU. Replica bounds 1–12; 10% HPA tolerance. Illustrative least-used
        placement, not the full Kubernetes scheduler. No memory, affinity,
        readiness delays or HPA stabilisation. Nodes are added manually here.
      </p>
    </ExperimentCard>
    <ExperimentCard
      id="mcp"
      tone="lilac"
      tinted
      number="02"
      title="Who’s allowed to do what?"
      subtitle="Choose a scenario, set the call budget and decide whether a simulated write is allowed."
      label="Agents + MCP / scripted SVG simulation"
    >
      <svg
        slot="stage"
        class="system-chart"
        viewBox="0 0 600 320"
        aria-hidden="true"
      ></svg>
      <p>
        Follow the scripted agent as it checks context, calls tools and stops at
        a timeout, missing context or denied write.
      </p>
      <div class="experiment-controls" hidden>
        <fieldset class="scenario-choices">
          <legend>Scenario</legend>
          {[
            ["read", "Read-only"],
            ["approval", "Approval"],
            ["timeout", "Timeout"],
            ["context", "Missing context"],
          ].map(([value, label]) => (
            <label>
              <input
                type="radio"
                name="scenario"
                value={value}
                checked={value === "read"}
              />
              {label}
            </label>
          ))}
        </fieldset>
        <label>
          Tool-call budget
          <input name="budget" type="range" min="0" max="4" value="3" />
        </label>
        <div class="experiment-actions approval-actions" hidden>
          <button type="button" data-approve>
            Allow simulated write
          </button>
          <button type="button" data-deny>
            Deny simulated write
          </button>
        </div>
        <button type="button" data-playback>
          Pause
        </button>
        <button type="button" data-reset>
          Reset
        </button>
      </div>
      <output aria-live="polite" aria-atomic="true">
        The script proposes a call. The host checks context, budget and approval
        before a simulated write.
      </output>
      <details class="trace-list">
        <summary>Follow the trace</summary>
        <ol>
          <li>Receive the task and check the available context.</li>
          <li>Propose a read-only tool call within the host's budget.</li>
          <li>Review the result. A proposed write needs host approval.</li>
          <li>
            Report the findings, or stop when context, permission or budget is
            missing.
          </li>
        </ol>
      </details>
      <p class="experiment-footnote">
        A scripted agent loop, not a live model or MCP server. Approval and
        budgets belong to this host policy, not automatic guarantees provided by
        MCP. Failed attempts count towards the budget.
      </p>
    </ExperimentCard>
    <ExperimentCard
      id="wave"
      tone="sage"
      number="03"
      title="A little interference."
      subtitle="Compare a clean wave with the same wave after interference is added."
      label="Canvas 2D / synthetic interference"
    >
      <SignalField slot="stage" expanded externalControls />
      <p>
        The upper trace stays clean. Change the lower trace's noise, frequency
        and amplitude.
      </p>
      <SignalControls expanded />
      <p class="experiment-footnote">
        Synthetic interference, not signal recovery or incident detection.
      </p>
    </ExperimentCard>
    <ExperimentCard
      id="latency"
      tone="peach"
      number="04"
      title="The average looks fine."
      subtitle="Keep most requests steady, then stretch the slowest ten."
      label="SVG / synthetic latency"
    >
      <Fragment slot="stage">
        <svg class="data-chart" viewBox="0 0 800 300" aria-hidden="true"></svg>
        <p class="chart-axis">
          <span>Fastest</span>
          <span>Slowest →</span>
        </p>
      </Fragment>
      <p>
        Move the tail slider and watch the median stay put while the slow end
        grows.
      </p>
      <div class="experiment-controls" hidden>
        <label>
          Slow requests
          <input
            name="tail"
            type="range"
            min="100"
            max="2000"
            step="50"
            value="500"
          />
        </label>
        <button type="button" data-playback>
          Pause
        </button>
        <button type="button" data-reset>
          Reset
        </button>
      </div>
      <output aria-live="polite" aria-atomic="true">
        The median stays steady; the slowest requests move the upper
        percentiles.
      </output>
      <p class="experiment-footnote">
        Sorted samples, fixed 0–2,000 ms scale. The readout gives the final
        distribution; the animation draws it in. No live traffic.
      </p>
    </ExperimentCard>
    <ExperimentCard
      id="requests"
      tone="lilac"
      number="05"
      title="Requests in flight."
      subtitle="Change how many requests run together and see which finish before the deadline."
      label="SVG / concurrency simulation"
    >
      <Fragment slot="stage">
        <svg class="data-chart" viewBox="0 0 800 300" aria-hidden="true"></svg>
        <p class="chart-axis">
          <span>Start</span>
          <span>Time →</span>
        </p>
      </Fragment>
      <p>
        Run the lookup with a different number in flight. Queued time counts
        against the deadline.
      </p>
      <div class="experiment-controls" hidden>
        <label>
          Concurrency
          <input name="concurrency" type="range" min="1" max="6" value="2" />
        </label>
        <label>
          Request latency
          <input
            name="latency"
            type="range"
            min="100"
            max="600"
            step="50"
            value="200"
          />
        </label>
        <label>
          Lookup deadline
          <input
            name="deadline"
            type="range"
            min="200"
            max="2400"
            step="100"
            value="1000"
          />
        </label>
        <button type="button" data-playback>
          Pause
        </button>
        <button type="button" data-reset>
          Reset
        </button>
      </div>
      <output aria-live="polite" aria-atomic="true">
        The readout will show how many of 12 requests meet the deadline.
      </output>
      <p class="experiment-footnote">
        Uniform duration, no retries or upstream contention. The readout gives
        the result at the deadline. Outlines are planned work; hatching marks
        work cut short.
      </p>
    </ExperimentCard>
    <ExperimentCard
      id="world"
      tone="sage"
      tinted
      number="06"
      title="A small connected world."
      subtitle="Rotate the graph or select a node to see its direct connections."
      label="Canvas 2D / imaginary 3D topology"
    >
      <div slot="stage" class="world-stage">
        <canvas hidden aria-hidden="true"></canvas>
      </div>
      <p>
        Drag to rotate. Select a node to highlight its neighbours and dim the
        rest.
      </p>
      <div class="experiment-controls" hidden>
        <label>
          Rotation
          <input name="rotation" type="range" min="0" max="360" value="25" />
        </label>
        <label>
          Tilt
          <input name="tilt" type="range" min="-60" max="60" value="15" />
        </label>
        <div class="node-choices" role="group" aria-label="Highlight a node">
          {nodes.map(({ name }) => (
            <button type="button" data-node aria-pressed="false">
              {name}
            </button>
          ))}
        </div>
        <button type="button" data-pause>
          Pause rotation
        </button>
        <button type="button" data-reset>
          Reset
        </button>
      </div>
      <output aria-live="polite" aria-atomic="true">
        All connections visible.
      </output>
      <details class="connection-list">
        <summary>See the connections</summary>
        <ul>
          {connections.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </details>
    </ExperimentCard>
  </div>
  <InternetMap />
  <LiveExperiments />
  <section class="play-outro" aria-labelledby="play-outro-title">
    <h2 id="play-outro-title">
      No real systems
      <br />
      <em>were harmed.</em>
    </h2>
    <div>
      <p>
        The little simulations run in your browser. The Internet atlas looks
        further afield, using public observations from Cloudflare Radar. The
        edge experiments use their own bounded services, separate from the
        browser-local simulations.
      </p>
      <a
        class="text-link"
        href={portfolioContent.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        Explore the source ↗<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </section>
</BaseLayout>
<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const cards = [
    ...document.querySelectorAll<HTMLElement>("[data-experiment], [data-live]"),
  ];
  const visible = new Set<Element>();
  function syncPreviews() {
    for (const card of cards)
      card.dataset.previewMotion =
        !reduced.matches &&
        !document.hidden &&
        visible.has(card) &&
        (card.dataset.live === "edge" ||
          !card.querySelector<HTMLDetailsElement>(".experiment-settings")?.open)
          ? "running"
          : "paused";
  }
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting)
        visible.add(entry.target.closest(".experiment")!);
      else visible.delete(entry.target.closest(".experiment")!);
    }
    syncPreviews();
  });
  reduced.addEventListener("change", syncPreviews);
  document.addEventListener("visibilitychange", syncPreviews);
  for (const card of cards) {
    observer.observe(card.querySelector(".experiment-stage")!);
    const settings = card.querySelector<HTMLDetailsElement>(
      ".experiment-settings",
    );
    if (!settings) continue;
    let loaded = false;
    const loadExperiment = async () => {
      syncPreviews();
      if (card.dataset.live) return;
      if (!settings.open || loaded) return;
      loaded = true;
      try {
        if (card.dataset.experiment === "world") {
          const { mountWorld } = await import("../playground/world");
          mountWorld(card);
          if (!card.classList.contains("world-ready")) return;
        } else if (["kubernetes", "mcp"].includes(card.dataset.experiment!)) {
          const { mountSystem } = await import("../playground/systems");
          mountSystem(card);
        } else if (card.dataset.experiment !== "wave") {
          const { mountChart } = await import("../playground/charts");
          mountChart(card);
        }
        card.classList.add("experiment-ready");
        card.querySelector<HTMLElement>(".interactive-stage")!.hidden = false;
      } catch {
        const output = card.querySelector("output");
        if (output)
          output.textContent =
            "The interactive view could not load. The preview is still available. Reload the page to try downloading it again.";
        const reload = document.createElement("button");
        reload.type = "button";
        reload.textContent = "Reload page";
        reload.addEventListener("click", () => window.location.reload());
        output?.after(reload);
      }
    };
    settings.addEventListener("toggle", () => {
      void loadExperiment();
    });
    // Browsers can restore an open disclosure during a page reload.
    if (settings.open) void loadExperiment();
  }
  syncPreviews();
</script>
