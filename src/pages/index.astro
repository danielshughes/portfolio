---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "../components/Contact.astro";
import EvidenceList from "../components/EvidenceList.astro";
import Hero from "../components/Hero.astro";
import WorkingFocus from "../components/WorkingFocus.astro";
import { portfolioContent } from "../content/portfolio";

const title = "Dan Hughes — Observability & SRE Leader";
const description =
  "A compact, evidence-led portfolio focused on SRE, infrastructure, observability, incident management and practical uses of AI.";
---

<BaseLayout {title} {description}>
  <Hero
    headline={portfolioContent.headline}
    support={portfolioContent.support}
    signal={portfolioContent.signal}
    links={portfolioContent.links}
  />
  <EvidenceList entries={portfolioContent.evidence} />
  <WorkingFocus items={portfolioContent.focus} />
  <Contact copy={portfolioContent.contact} links={portfolioContent.links} />
</BaseLayout>
