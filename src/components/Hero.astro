---
import type { ExternalLink } from "../content/portfolio";

interface Props {
  headline: "Observability & SRE Leader";
  support: string;
  signal: string;
  links: readonly ExternalLink[];
}

const { headline, support, signal, links } = Astro.props;
---

<section class="intro" aria-labelledby="page-title">
  <div class="intro__index" aria-hidden="true">
    <span>Signal</span>
    <strong>00</strong>
  </div>

  <div class="intro__content">
    <p class="eyebrow">SRE · Infrastructure · Observability</p>
    <h1 id="page-title">{headline}</h1>
    <p class="lede">{support}</p>
    <p class="intro__signal">{signal}</p>

    <nav class="intro__actions" aria-label="Portfolio links">
      {
        links.map(({ label, href }, index) => (
          <a class:list={["text-link", { "text-link--primary": index === 2 }]} href={href}>
            {label}
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </nav>
  </div>
</section>
