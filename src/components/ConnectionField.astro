---
const junctions = [
  [34, 230],
  [128, 210],
  [214, 145],
  [188, 52],
  [316, 178],
  [375, 106],
  [469, 141],
  [568, 66],
  [360, 267],
  [468, 285],
  [421, 42],
];
// A short offshoot and a longer branching chain leave deliberate open space.
const links = [
  { from: 0, to: 1, d: "M34 230C68 240 95 202 128 210" },
  { from: 1, to: 2, d: "M128 210C183 224 168 159 214 145" },
  { from: 2, to: 3, d: "M214 145C227 105 171 94 188 52" },
  { from: 2, to: 4, d: "M214 145C261 122 272 193 316 178" },
  { from: 4, to: 5, d: "M316 178C348 164 327 110 375 106" },
  { from: 5, to: 6, d: "M375 106C415 98 420 159 469 141" },
  { from: 6, to: 7, d: "M469 141C522 128 506 60 568 66" },
  { from: 4, to: 8, d: "M316 178C341 213 330 247 360 267" },
  { from: 8, to: 9, d: "M360 267C392 298 430 271 468 285" },
  { from: 5, to: 10, d: "M375 106C412 105 428 81 421 42" },
];
---

<figure class="connection-field" data-motion="idle">
  <div class="connection-surface">
    <svg viewBox="0 0 600 330" fill="none" aria-hidden="true">
      <g class="connection-guides">
        <path
          d="M79 149C99 49 293 5 365 52M169 294C259 330 520 279 554 178"
          stroke-dasharray="2 8"
        />
      </g>
      {links.map(({ from, to, d }) => (
        <g>
          <path class="connection-wire" data-from={from} data-to={to} d={d} />
          <circle class="connection-pulse" r="3" opacity="0" />
        </g>
      ))}
      {junctions.map(([x, y], index) => (
        <circle
          class="connection-junction"
          data-junction={index}
          cx={x}
          cy={y}
          r={index === 2 ? 8 : 4}
        />
      ))}
      <g class="connection-ticks">
        <path d="M35 45H45M40 40V50M555 290H565M560 285V295" />
      </g>
    </svg>
    <button
      class="connection-trigger"
      type="button"
      aria-label="Send a pulse through the connection graphic"
      aria-describedby="connection-description"
      hidden
    ></button>
  </div>
  <figcaption>
    <span id="connection-description">Just a few connections.</span>
    <a class="text-link" href="/experiments/">
      Explore experiments <span aria-hidden="true">↗</span>
    </a>
  </figcaption>
</figure>

<style>
  .connection-field {
    min-width: 0;
    margin: 0;
  }
  .connection-surface {
    position: relative;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .connection-guides {
    stroke: var(--line);
    stroke-width: 1;
  }
  .connection-wire {
    stroke: var(--muted);
    stroke-width: 1.3;
  }
  .connection-junction {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .connection-junction[data-junction="2"],
  .connection-junction[data-active] {
    fill: var(--orange);
    stroke: var(--orange);
  }
  .connection-pulse {
    fill: var(--orange);
  }
  .connection-ticks {
    stroke: var(--muted);
  }
  .connection-trigger {
    position: absolute;
    inset: 0;
    width: 100%;
    border: 0;
    background: none;
    cursor: crosshair;
    border-radius: 1rem;
    touch-action: pan-y;
  }
  .connection-trigger:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 4px;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--control-gap) var(--space-sm);
    font-size: 0.8rem;
    color: var(--muted);
  }
  figcaption .text-link {
    color: var(--ink);
  }
  @media (max-width: 600px) {
    .connection-surface {
      margin-inline: -0.3rem;
    }
  }
</style>

<script>
  const field = document.querySelector<HTMLElement>(".connection-field");
  if (field) {
    const svg = field.querySelector("svg")!;
    const trigger = field.querySelector<HTMLButtonElement>("button")!;
    const nodes = [
      ...field.querySelectorAll<SVGCircleElement>(".connection-junction"),
    ];
    const edges = [
      ...field.querySelectorAll<SVGPathElement>(".connection-wire"),
    ].map((path, index) => ({
      path,
      from: Number(path.dataset.from),
      to: Number(path.dataset.to),
      length: path.getTotalLength(),
      delay: (index * 73) % 190,
      duration: 460 + ((index * 97) % 230),
      dot: path.nextElementSibling as SVGCircleElement,
    }));
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;
    let visible = false;
    let greeted = false;
    let lastNode = -1;
    let lastSent = 0;
    trigger.hidden = false;

    function stop() {
      cancelAnimationFrame(frame);
      frame = 0;
      field!.dataset.motion = "idle";
      edges.forEach((edge) => edge.dot.setAttribute("opacity", "0"));
    }

    function pulse(origin: number) {
      stop();
      nodes.forEach((node, index) =>
        node.toggleAttribute("data-active", index === origin),
      );
      if (reduced.matches || document.hidden || !visible) return;
      // Hop distances only choreograph this abstract graphic. They are not telemetry.
      const hops = nodes.map(() => Infinity);
      hops[origin] = 0;
      const queue = [origin];
      for (const node of queue) {
        for (const edge of edges) {
          const neighbour =
            edge.from === node ? edge.to : edge.to === node ? edge.from : -1;
          if (neighbour >= 0 && hops[neighbour] === Infinity) {
            hops[neighbour] = hops[node] + 1;
            queue.push(neighbour);
          }
        }
      }
      const start = performance.now();
      const duration = Math.max(
        ...edges.map(
          (edge) =>
            Math.min(hops[edge.from], hops[edge.to]) * 230 +
            edge.delay +
            edge.duration,
        ),
      );
      lastSent = start;
      field!.dataset.motion = "running";
      function tick(now: number) {
        const elapsed = now - start;
        for (const edge of edges) {
          const forward = hops[edge.from] <= hops[edge.to];
          const progress =
            (elapsed -
              Math.min(hops[edge.from], hops[edge.to]) * 230 -
              edge.delay) /
            edge.duration;
          const active = progress >= 0 && progress <= 1;
          edge.dot.setAttribute("opacity", active ? "1" : "0");
          if (active) {
            const point = edge.path.getPointAtLength(
              (forward ? progress : 1 - progress) * edge.length,
            );
            edge.dot.setAttribute("cx", String(point.x));
            edge.dot.setAttribute("cy", String(point.y));
          }
        }
        if (elapsed < duration) frame = requestAnimationFrame(tick);
        else stop();
      }
      frame = requestAnimationFrame(tick);
    }

    function nearest(event: MouseEvent) {
      const matrix = svg.getScreenCTM();
      if (!matrix) return 2;
      const point = new DOMPoint(event.clientX, event.clientY).matrixTransform(
        matrix.inverse(),
      );
      let nearestIndex = 2,
        distance = Infinity;
      nodes.forEach((node, index) => {
        const next = Math.hypot(
          point.x - node.cx.baseVal.value,
          point.y - node.cy.baseVal.value,
        );
        if (next < distance) {
          distance = next;
          nearestIndex = index;
        }
      });
      return nearestIndex;
    }

    trigger.addEventListener("click", (event) =>
      pulse(event.detail === 0 ? 2 : nearest(event)),
    );
    trigger.addEventListener("focus", () => pulse(2));
    trigger.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse") return;
      const node = nearest(event);
      if (node !== lastNode && performance.now() - lastSent > 450) {
        lastNode = node;
        pulse(node);
      }
    });
    trigger.addEventListener("pointerleave", () => {
      lastNode = -1;
    });
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (!visible) stop();
      else if (!greeted) {
        greeted = true;
        pulse(2);
      }
    }).observe(field);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
    });
    reduced.addEventListener("change", () => {
      if (reduced.matches) stop();
    });
  }
</script>
