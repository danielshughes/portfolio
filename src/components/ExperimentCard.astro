---
import ExperimentPreview from "./ExperimentPreview.astro";
interface Props {
  id: string;
  number: string;
  title: string;
  subtitle: string;
  label: string;
  tone: "peach" | "sage" | "lilac";
  tinted?: boolean;
  live?: boolean;
  caption?: string;
}
const {
  id,
  number,
  title,
  subtitle,
  label,
  tone,
  tinted = false,
  live = false,
  caption = "Illustrative preview",
} = Astro.props;
const Heading = live ? "h3" : "h2";
---

<article
  class={`experiment experiment-${id}`}
  id={id}
  data-tone={tone}
  data-tinted={tinted ? "" : undefined}
  data-experiment={live ? undefined : id}
  data-live={live ? id : undefined}
  aria-labelledby={`${id}-title`}
>
  <header class="experiment-card-heading">
    <span class="experiment-number">{number}</span>
    <div>
      <Heading id={`${id}-title`}>{title}</Heading>
      <p>{subtitle}</p>
    </div>
  </header>
  <div class="experiment-stage">
    <span class="stage-label">{label}</span>
    <div class="experiment-visual">
      <slot name="preview">
        <ExperimentPreview kind={id} />
      </slot>
      {!live && (
        <div class="interactive-stage" hidden>
          <slot name="stage" />
        </div>
      )}
    </div>
    <span class="preview-caption">{caption}</span>
  </div>
  <details class="experiment-settings">
    <summary>
      Explore <span class="sr-only">{title}</span>
      <span aria-hidden="true">↗</span>
    </summary>
    <div class="experiment-desk">
      <slot />
    </div>
  </details>
</article>
