---
import type { EvidenceEntry } from "../content/portfolio";

interface Props {
  entries: readonly [EvidenceEntry, EvidenceEntry, EvidenceEntry];
}

const { entries } = Astro.props;
---

<section class="page-section evidence" id="evidence" aria-labelledby="evidence-title">
  <header class="section-heading">
    <p class="eyebrow">Decision record · 01</p>
    <h2 id="evidence-title">Selected evidence</h2>
  </header>

  <ol class="evidence-list">
    {
      entries.map(({ heading, need, contribution, outcome }, index) => (
        <li>
          <article class="evidence-entry">
            <header>
              <span class="evidence-entry__number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>{heading}</h3>
            </header>

            <dl>
              <div>
                <dt>Need</dt>
                <dd>{need}</dd>
              </div>
              <div>
                <dt>Contribution</dt>
                <dd>{contribution}</dd>
              </div>
              <div>
                <dt>Outcome</dt>
                <dd>{outcome}</dd>
              </div>
            </dl>
          </article>
        </li>
      ))
    }
  </ol>
</section>
