---
import type { ExternalLink } from "../content/portfolio";

interface Props {
  copy: string;
  links: readonly ExternalLink[];
}

const { copy, links } = Astro.props;
---

<section class="page-section contact" id="contact" aria-labelledby="contact-title">
  <div>
    <p class="eyebrow">Open channel · 03</p>
    <h2 id="contact-title">Continue the conversation</h2>
  </div>

  <div class="contact__body">
    <p>{copy}</p>
    <nav class="contact__links" aria-label="Contact and profiles">
      {
        links.map(({ label, href }) => (
          <a class="text-link" href={href}>
            {label}
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </nav>
  </div>
</section>
